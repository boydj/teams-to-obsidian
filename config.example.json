{
  "capture": {
    "captureMode": "processTap",
    "micVoiceProcessing": false
  },
  "context": {
    "activeSpeakerPattern": "(?i)^(.+?),?\\s+(?:is\\s+)?speaking\\b",
    "calendarNames": [],
    "captureActiveSpeakers": false,
    "useCalendar": true,
    "useWindowTitle": true
  },
  "detection": {
    "bundleIDPrefixes": ["com.microsoft.teams2"],
    "endDebounceSeconds": 10,
    "minMeetingDurationSeconds": 60,
    "pollIntervalSeconds": 2,
    "startDebounceSeconds": 3,
    "useOutputSignal": false
  },
  "diarization": {
    "binaryPath": "~/.local/share/teams-to-obsidian/sherpa-onnx/bin/sherpa-onnx-offline-speaker-diarization",
    "clusterThreshold": 0.5,
    "embeddingModelPath": "~/.local/share/teams-to-obsidian/sherpa-onnx/nemo_en_titanet_small.onnx",
    "enabled": false,
    "numSpeakers": 0,
    "segmentationModelPath": "~/.local/share/teams-to-obsidian/sherpa-onnx/sherpa-onnx-pyannote-segmentation-3-0/model.onnx"
  },
  "notifications": {
    "enabled": true
  },
  "recording": {
    "directory": "~/Library/Application Support/teams-to-obsidian/recordings",
    "keepAudio": false
  },
  "summarizer": {
    "backend": "bedrock",
    "bedrock": {
      "maxTokens": 4096,
      "modelID": "anthropic.claude-opus-4-8",
      "region": "us-east-1"
    },
    "maxTranscriptChars": 200000,
    "ollama": {
      "baseURL": "http://localhost:11434",
      "model": "llama3.1"
    }
  },
  "vault": {
    "filenameTemplate": "{date} {title}",
    "notesFolder": "Meetings",
    "path": "~/Documents/ObsidianVault",
    "taskTag": ""
  },
  "whisper": {
    "cliPath": "~/.local/share/teams-to-obsidian/whisper.cpp/build/bin/whisper-cli",
    "language": "en",
    "modelPath": "~/.local/share/teams-to-obsidian/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin",
    "threads": 0
  }
}
